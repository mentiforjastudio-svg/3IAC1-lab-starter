# Configuration Nginx générée par Ansible
# Serveur  : {{ inventory_hostname }}
# Environnement : {{ deploy_environment | default('development') }}

server {
    listen 80;
    server_name {{ inventory_hostname }};

    root /var/www/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

{% if deploy_environment | default('development') == 'production' %}
    # Options production uniquement
    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;
{% endif %}
}
