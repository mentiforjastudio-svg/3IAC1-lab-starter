# =============================================================================
# Template Nginx — reverse proxy sécurisé
# Généré par Ansible depuis templates/nginx.conf.j2
# =============================================================================

# TODO Q4 : Compléter cette configuration
# Éléments à ajouter :
#   - limit_req_zone pour le rate limiting
#   - server_tokens off
#   - En-têtes de sécurité (X-Frame-Options, X-Content-Type-Options, etc.)
#   - proxy_pass vers {{ flask_upstream }}
#   - proxy_set_header pour transmettre l'IP réelle

# Indice : l'upstream Flask est accessible via la variable {{ flask_upstream }}

limit_req_zone $binary_remote_addr zone=app:10m rate=10r/s;

server {
    listen {{ nginx_port }};
    server_tokens off;

    add_header X-Frame-Options       "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection       "1; mode=block";
    add_header Referrer-Policy        "strict-origin";

    location / {
        limit_req zone=app burst=20 nodelay;

        proxy_pass http://{{ flask_upstream }};

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;

        proxy_hide_header X-Powered-By;
    }
}
